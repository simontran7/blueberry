{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug blueberry",
            "type": "lldb",
            "request": "launch",
            "sourceLanguages": [
                "rust"
            ],
            "cargo": {
                "args": [
                    "build",
                    "--bin=blueberry"
                ]
            },
            "args": [
                "check",
                "--path=main.bb",
                "--emit=hir"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "stopOnEntry": false
        },
        {
            "name": "Debug tests",
            "type": "lldb",
            "request": "launch",
            "sourceLanguages": [
                "rust"
            ],
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib"
                ]
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "stopOnEntry": false
        }
    ]
}
