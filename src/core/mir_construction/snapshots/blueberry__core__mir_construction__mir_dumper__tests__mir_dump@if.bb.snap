function pick(Bool, I32, I32) -> I32 {
Block0(v0: Bool, v1: I32, v2: I32):
    ConditionalBranch v0, Block1, Block2

Block1:
    Jump Block3(v1)

Block2:
    Jump Block3(v2)

Block3(v3: I32):
    Return v3
}

function without_else(Bool) -> I32 {
Block0(v0: Bool):
    v1 = IntegerLiteral 1
    ConditionalBranch v0, Block1, Block2(v1)

Block1:
    v2 = IntegerLiteral 2
    Jump Block2(v2)

Block2(v3: I32):
    Return v3
}

function early(Bool) -> I32 {
Block0(v0: Bool):
    ConditionalBranch v0, Block1, Block2

Block1:
    v1 = IntegerLiteral 1
    Return v1

Block2:
    v2 = IntegerLiteral 2
    Return v2
}

function both_return(Bool) -> I32 {
Block0(v0: Bool):
    ConditionalBranch v0, Block1, Block2

Block1:
    v2 = IntegerLiteral 1
    Return v2

Block2:
    v3 = IntegerLiteral 2
    Return v3
}
