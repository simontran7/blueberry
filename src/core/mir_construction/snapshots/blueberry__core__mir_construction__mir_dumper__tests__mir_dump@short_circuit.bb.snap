---
source: src/core/mir_construction/mir_dumper.rs
expression: "MirBodyDumper::dump_file(&db, file).unwrap()"
input_file: src/core/mir_construction/snapshot_inputs/short_circuit.bb
---
function both(Bool, Bool) -> Bool {
Block0(v0: Bool, v1: Bool):
    ConditionalBranch v0, Block1, Block2(v0)

Block1:
    Jump Block2(v1)

Block2(v2: Bool):
    Return v2
}

function either(Bool, Bool) -> Bool {
Block0(v0: Bool, v1: Bool):
    ConditionalBranch v0, Block2(v0), Block1

Block1:
    Jump Block2(v1)

Block2(v2: Bool):
    Return v2
}

function diverging_rhs(Bool) -> Bool {
Block0(v0: Bool):
    ConditionalBranch v0, Block1, Block2(v0)

Block1:
    v2 = BooleanLiteral false
    Return v2

Block2(v1: Bool):
    Return v1
}
